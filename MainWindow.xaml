<Window
    x:Class="Codewright.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Codewright">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,18,20,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                    <TextBlock Text="Codewright" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="GitHub 工作区 · 轻量桌面客户端" Opacity="0.65" FontSize="12" />
                </StackPanel>
                <TextBox x:Name="RepoPathBox" Grid.Column="1" PlaceholderText="尚未打开本地 Git 仓库" IsReadOnly="True" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="打开文件夹" Click="PickFolder_Click" />
                <Button Grid.Column="3" Content="刷新" Click="Refresh_Click" />
                <Button Grid.Column="4" Content="分支管理" Click="BranchManager_Click" />
                <Button Grid.Column="5" Content="拉取" Click="Pull_Click" />
                <Button Grid.Column="6" Content="推送" Click="Push_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE821;" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="BranchText" Text="未打开仓库" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="RepoSummaryText" Text="选择工作目录后可以暂不连接 GitHub，继续使用本地功能。" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <InfoBar Grid.Column="3" x:Name="StatusBar" IsOpen="False" Severity="Informational" HorizontalAlignment="Right" MaxWidth="560" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Padding="20" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.85*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="工作区" FontSize="18" FontWeight="SemiBold" />
                <Border Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="变更" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" x:Name="ChangesList" SelectionMode="None" MinHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Status}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="2" x:Name="ChangesEmptyText" Text="工作区干净" Opacity="0.65" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="提交" FontSize="18" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="提交并推送" Click="CommitPush_Click" />
                </Grid>
                <Border Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBox x:Name="CommitMessageBox" PlaceholderText="输入提交信息…" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="最近提交" FontSize="18" FontWeight="SemiBold" />
                <Border Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ListView x:Name="LogList" SelectionMode="None" MinHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ShortHash}" FontFamily="Cascadia Mono" Opacity="0.75" />
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Author}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                    <TextBlock Grid.Column="3" Text="{Binding Date}" HorizontalAlignment="Right" Opacity="0.65" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
